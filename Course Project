# Mode 1 = cruise (-1 deg flap)
# Mode 2 = climb (-5 deg flap)
# Define optimization parameters
class Config:

    YIELD_STRESS = 42e6
    E = 2.34e9
    CHORD = 1.0 # per unit chord
    SPAN = 1.0  # per unit span

    # Optimization bounds for 0.03m chord
    CHORD_REF = 0.30
    T_REF_BOUNDS = (0.00045, 0.00135)  # [m]

    # Actuator displacement initializations and ranges
    ACTUATOR_MODE1_REF = -0.004
    ACTUATOR_MODE2_REF = -0.005
    ACT_RANGE1_REF = (-0.003, 0.003)
    ACT_RANGE2_REF = (-0.003, 0.003)

    ACTUATOR_MODE1 = None
    ACTUATOR_MODE2 = None
    MORPH_START = 0.7 # non-dimensional morphing region start

    # XFOIL geometry + Cp data files
    FLAP_PATH_MODE1 = r"XFOIL Climb Data (Mode 2).xlsx"  # −1° flap (cruise)
    FLAP_SHEET_MODE1 = "polar -1 deg flap climb"

    FLAP_PATH_MODE2 = r"XFOIL Cruise Data (Mode 1).xlsx" # −5° flap (climb)
    FLAP_SHEET_MODE2 = "-5 deg flap"

    # Aerodynamic conditions
    RHO_MODE1 = 0.344
    RHO_MODE2 = 0.653
    V_MODE1 = 230.1
    V_MODE2 = 144.04

    # AERO_SCALE = 1.0

    # chord scaler
    @classmethod
    def chord_scale(cls):
        return cls.CHORD / cls.CHORD_REF

    # thickness bounds scaler
    @classmethod
    def get_thickness_bounds(cls):
        s = cls.chord_scale()
        t_min_ref, t_max_ref = cls.T_REF_BOUNDS
        return t_min_ref * s, t_max_ref * s

    # actuator intialization scaler
    @classmethod
    def init_scaled_defaults(cls):
        s = cls.chord_scale()
        cls.ACTUATOR_MODE1 = cls.ACTUATOR_MODE1_REF * s
        cls.ACTUATOR_MODE2 = cls.ACTUATOR_MODE2_REF * s

    # actuator displacement ranges scaler
    @classmethod
    def get_actuator_search_ranges(cls):
        s = cls.chord_scale()
        u1_min_ref, u1_max_ref = cls.ACT_RANGE1_REF
        u2_min_ref, u2_max_ref = cls.ACT_RANGE2_REF
        return (
            u1_min_ref * s,
            u1_max_ref * s,
            u2_min_ref * s,
            u2_max_ref * s,
        )

    # Dynamic pressure helpers
    @classmethod
    def q_mode1(cls):
        return 0.5 * cls.RHO_MODE1 * cls.V_MODE1**2

    @classmethod
    def q_mode2(cls):
        return 0.5 * cls.RHO_MODE2 * cls.V_MODE2**2


# Geometry generation
class WingGeometry:

    def __init__(self, naca_code=(2, 4, 12)):
        # NACA 2412 (m = camber, p = location, t = thickness)
        self.m = naca_code[0] / 100.0
        self.p = naca_code[1] / 10.0
        self.t = naca_code[2] / 100.0

        # Baseline x-coordinates
        self.x_base = np.linspace(0.0, Config.CHORD, 400)
        x_c = self.x_base / Config.CHORD

        # Mean camber line
        yc = np.zeros_like(self.x_base)
        mask1 = x_c < self.p
        mask2 = ~mask1
        yc[mask1] = (self.m / self.p**2) * (2 * self.p * x_c[mask1] - x_c[mask1]**2)
        yc[mask2] = (self.m / (1 - self.p)**2) * (
            (1 - 2 * self.p) + 2 * self.p * x_c[mask2] - x_c[mask2]**2
        )
        yc *= Config.CHORD

        # Thickness distribution
        yt = 5 * self.t * Config.CHORD * (
            0.2969 * np.sqrt(x_c)
            - 0.1260 * x_c
            - 0.3516 * x_c**2
            + 0.2843 * x_c**3
            - 0.1015 * x_c**4
        )

        # Local slope of camber line
        dyc_dx = np.gradient(yc, self.x_base)
        theta = np.arctan(dyc_dx)

        # Outer upper and lower surfaces of the airfoil
        self.xu = self.x_base - yt * np.sin(theta)
        self.yu = yc + yt * np.cos(theta)
        self.xl = self.x_base + yt * np.sin(theta)
        self.yl = yc - yt * np.cos(theta)

    # Build inner beam skeleton
    # upper strip, lower strip, 4 vertical ribs
    def generate_mesh(self, t_skin,
                      rib1_param, rib2_param, rib3_param, rib4_param):

        # non dimensional rib positions
        # can be anywhere from 0.75c to 0.95c
        rib1_frac = 0.75 + 0.20 * rib1_param
        rib2_frac = 0.75 + 0.20 * rib2_param
        rib3_frac = 0.75 + 0.20 * rib3_param
        rib4_frac = 0.75 + 0.20 * rib4_param

        rib_x_list = [
            rib1_frac * Config.CHORD,
            rib2_frac * Config.CHORD,
            rib3_frac * Config.CHORD,
            rib4_frac * Config.CHORD,
        ]

        # Nodes only in morphing region
        x_start = Config.MORPH_START * Config.CHORD

        # Increase resolution in morph region
        # finer mesh for better curvature, negligible effect on results
        # does not change design space
        # gets smoother interpolation in compute_shape_error and more flexibility
        # in how bending distributes between ribs
        N_nodes_chord = 1000
        x_mesh = np.linspace(x_start, Config.CHORD, N_nodes_chord)

        # Interpolate baseline upper/lower outer surfaces
        yu_mesh = np.interp(x_mesh, self.xu, self.yu)
        yl_mesh = np.interp(x_mesh, self.xl, self.yl)

        # offset half thickness
        nodes_u = np.column_stack([x_mesh, yu_mesh - t_skin / 2.0])
        nodes_l = np.column_stack([x_mesh, yl_mesh + t_skin / 2.0])

        # assemble nodes and elements
        all_nodes = list(nodes_u) + list(nodes_l)
        elems = []
        t_elems = []

        # strip elements
        for i in range(N_nodes_chord - 1):
            elems.append([i, i + 1])
            t_elems.append(t_skin)

        offset = N_nodes_chord
        for i in range(N_nodes_chord - 1):
            elems.append([offset + i, offset + i + 1])
            t_elems.append(t_skin)

        # ribs
        for x_loc in rib_x_list:
            idx_u = int(np.argmin(np.abs(nodes_u[:, 0] - x_loc)))
            idx_l = int(np.argmin(np.abs(nodes_l[:, 0] - x_loc))) + offset

            p_top = np.array(all_nodes[idx_u])
            p_bot = np.array(all_nodes[idx_l])
            mid_point = 0.5 * (p_top + p_bot)
            mid_idx = len(all_nodes)
            all_nodes.append(mid_point)

            # two beam elements
            elems.append([idx_u, mid_idx])
            elems.append([mid_idx, idx_l])
            t_elems.append(t_skin)
            t_elems.append(t_skin)

        nodes = np.array(all_nodes, dtype=float)
        elems = np.array(elems, dtype=int)
        t_elems = np.array(t_elems, dtype=float)

        # Indices for boundary conditions and shape error
        idx_upper_root = int(np.argmin(np.abs(nodes_u[:, 0] - x_start)))
        idx_lower_root = int(np.argmin(np.abs(nodes_l[:, 0] - x_start))) + offset

        info = dict(
            idx_upper_root=idx_upper_root,
            idx_lower_root=idx_lower_root,
            N_nodes_chord=N_nodes_chord,
            rib1_x=rib_x_list[0],
            rib2_x=rib_x_list[1],
            rib3_x=rib_x_list[2],
            rib4_x=rib_x_list[3],
        )

        return nodes, elems, t_elems, info


# 2D Euler-Bernoulli FEM solver
# each geometry element is a beam
# 3 DOFs per node (u, v, theta)
class FEMSolver:

    # local 6x6 beam stiffness in global coordinates
    def beam_stiffness(self, p1, p2, t):
        dx, dy = p2 - p1
        L = np.hypot(dx, dy)
        if L < 1e-10:
            return np.zeros((6, 6))

        c, s = dx / L, dy / L
        b = Config.SPAN
        A = b * t
        I = b * t**3 / 12.0
        E = Config.E

        k = np.zeros((6, 6))

        # axial
        k[0, 0] = E * A / L
        k[0, 3] = -E * A / L
        k[3, 0] = -E * A / L
        k[3, 3] = E * A / L

        # bending
        k[1, 1] = 12 * E * I / L**3
        k[1, 2] = 6 * E * I / L**2
        k[1, 4] = -12 * E * I / L**3
        k[1, 5] = 6 * E * I / L**2

        k[2, 2] = 4 * E * I / L
        k[2, 4] = -6 * E * I / L**2
        k[2, 5] = 2 * E * I / L

        k[4, 4] = 12 * E * I / L**3
        k[4, 5] = -6 * E * I / L**2

        k[5, 5] = 4 * E * I / L

        # Fill symmetry
        k[2, 1] = k[1, 2]
        k[4, 1] = k[1, 4]
        k[5, 1] = k[1, 5]
        k[4, 2] = k[2, 4]
        k[5, 2] = k[2, 5]
        k[5, 4] = k[4, 5]

        # Rotation matrix from local to global
        m = np.array([[c, s, 0.0],
                      [-s, c, 0.0],
                      [0.0, 0.0, 1.0]])
        R = np.zeros((6, 6))
        R[0:3, 0:3] = m
        R[3:6, 3:6] = m

        return R.T @ k @ R

    # compute axial and bending stress at outer fiber of element
    def get_stress(self, p1, p2, t, u_global):
        dx, dy = p2 - p1
        L = np.hypot(dx, dy)
        if L < 1e-10:
            return 0.0

        c, s = dx / L, dy / L
        m = np.array([[c, s, 0.0],
                      [-s, c, 0.0],
                      [0.0, 0.0, 1.0]])
        R = np.zeros((6, 6))
        R[0:3, 0:3] = m
        R[3:6, 3:6] = m

        # Transform DOFs to local coords
        u_loc = R @ u_global
        u1, v1, th1, u2, v2, th2 = u_loc

        # Axial strain + curvature
        strain_ax = (u2 - u1) / L
        curvature = (th2 - th1) / L

        sigma = Config.E * (strain_ax + (t / 2.0) * curvature)
        return abs(sigma)

    # Build aerodynamic force vector from XFOIL Cp(x) distributions
    # vertical distributed load
    def build_aero_load_vector(self, nodes, info, cp_u_func, cp_l_func, q_inf):
        N = info["N_nodes_chord"]
        offset = N
        n_nodes = nodes.shape[0]
        F = np.zeros(n_nodes * 3)

        for i in range(N - 1):
            x1 = nodes[i, 0]
            x2 = nodes[i + 1, 0]
            xc = 0.5 * (x1 + x2)
            dx = x2 - x1

            cp_u = float(cp_u_func(xc))
            cp_l = float(cp_l_func(xc))

            if not np.isfinite(cp_u) or not np.isfinite(cp_l):
                continue

            dp = Config.AERO_SCALE * q_inf * (cp_l - cp_u)
            w = dp * Config.SPAN # unit load
            F_seg = w * dx

            # downward is --y
            Fy = -F_seg
            share = Fy / 4.0
            for nid in (i, i + 1, offset + i, offset + i + 1):
                F[3 * nid + 1] += share

        return F

    # assemble stiffness matrix and force vector and solve Ku = F
    # apply BCs using penalty method and solve
    def solve(self, nodes, elems, t_elems, actuator_disp, info, F_ext=None):
        n_nodes = nodes.shape[0]
        ndof = n_nodes * 3

        rows, cols, vals = [], [], []

        # global k
        for i, el in enumerate(elems):
            n1, n2 = int(el[0]), int(el[1])
            p1 = nodes[n1]
            p2 = nodes[n2]
            t = t_elems[i]

            k_loc = self.beam_stiffness(p1, p2, t)

            dofs = [3 * n1, 3 * n1 + 1, 3 * n1 + 2,
                    3 * n2, 3 * n2 + 1, 3 * n2 + 2]

            for r in range(6):
                for c in range(6):
                    rows.append(dofs[r])
                    cols.append(dofs[c])
                    vals.append(k_loc[r, c])

        K = sp.coo_matrix((vals, (rows, cols)), shape=(ndof, ndof)).tocsc()
        F = np.zeros(ndof)

        # aerodynamic loads
        if F_ext is not None:
            if F_ext.shape[0] != ndof:
            else:
                F += F_ext

        # BCs
        pen = 1e15
        ur = info["idx_upper_root"]
        lr = info["idx_lower_root"]

        # Upper root fixed
        du = 3 * ur
        K[du, du] += pen
        K[du + 1, du + 1] += pen
        K[du + 2, du + 2] += pen

        # Lower root gets prescribed horizontal actuator displacement
        dl = 3 * lr
        K[dl, dl] += pen
        F[dl] += pen * actuator_disp
        K[dl + 1, dl + 1] += pen
        K[dl + 2, dl + 2] += pen

        # solve Ku = F
        try:
            u = spla.spsolve(K, F)
        except Exception as e:
            return None, 1e12

        # max stress over all elements
        sigma_max = 0.0
        for i, el in enumerate(elems):
            n1, n2 = int(el[0]), int(el[1])
            u_vec = np.array([
                u[3 * n1],     u[3 * n1 + 1],     u[3 * n1 + 2],
                u[3 * n2],     u[3 * n2 + 1],     u[3 * n2 + 2],
            ])
            s = self.get_stress(nodes[n1], nodes[n2], t_elems[i], u_vec)
            if s > sigma_max:
                sigma_max = s

        return u, sigma_max


# XFOIL flap shapes and shape error
# Makima interpolation
def _find_cp_col_after(df, x_col_name):
    cols = df.columns
    base = cols.get_loc(x_col_name)
    for j in range(1, 5):
        if base + j >= len(cols):
            break
        cand = cols[base + j]
        if str(df[cand].iloc[0]).strip().lower() == "cp":
            return cand


def load_flap_shape_and_cp(path, sheet_name):
    df = pd.read_excel(path, sheet_name=sheet_name)
    x_l = pd.to_numeric(df["Lower Surface (sorted)"], errors="coerce").to_numpy()
    y_l = pd.to_numeric(
        df[df.columns[df.columns.get_loc("Lower Surface (sorted)") + 1]],
        errors="coerce"
    ).to_numpy()
    x_u = pd.to_numeric(df["Upper surface (sorted)"], errors="coerce").to_numpy()
    y_u = pd.to_numeric(
        df[df.columns[df.columns.get_loc("Upper surface (sorted)") + 1]],
        errors="coerce"
    ).to_numpy()

    # Remove NaNs
    mask_l = np.isfinite(x_l) & np.isfinite(y_l)
    mask_u = np.isfinite(x_u) & np.isfinite(y_u)
    x_l, y_l = x_l[mask_l], y_l[mask_l]
    x_u, y_u = x_u[mask_u], y_u[mask_u]

    # Convert to physical coordinates
    x_l *= Config.CHORD
    y_l *= Config.CHORD
    x_u *= Config.CHORD
    y_u *= Config.CHORD

    # Restrict to morphing region
    x_min = Config.MORPH_START * Config.CHORD
    x_max = Config.CHORD
    mask_l = (x_l >= x_min) & (x_l <= x_max)
    mask_u = (x_u >= x_min) & (x_u <= x_max)
    x_l, y_l = x_l[mask_l], y_l[mask_l]
    x_u, y_u = x_u[mask_u], y_u[mask_u]

    fu = Akima1DInterpolator(x_u, y_u)  # target upper
    fl = Akima1DInterpolator(x_l, y_l)  # target lower

    # Cp(x) upper/lower
    x_cp_u_col = "Cp(x) and P(x) upper (sorted)"
    x_cp_l_col = "Cp(x) and P(x) lower (sorted)"

    cp_u_col = _find_cp_col_after(df, x_cp_u_col)
    cp_l_col = _find_cp_col_after(df, x_cp_l_col)

    x_cp_u = pd.to_numeric(df[x_cp_u_col], errors="coerce").to_numpy()
    cp_u = pd.to_numeric(df[cp_u_col], errors="coerce").to_numpy()
    x_cp_l = pd.to_numeric(df[x_cp_l_col], errors="coerce").to_numpy()
    cp_l = pd.to_numeric(df[cp_l_col], errors="coerce").to_numpy()

    mask_cu = np.isfinite(x_cp_u) & np.isfinite(cp_u)
    mask_cl = np.isfinite(x_cp_l) & np.isfinite(cp_l)
    x_cp_u, cp_u = x_cp_u[mask_cu], cp_u[mask_cu]
    x_cp_l, cp_l = x_cp_l[mask_cl], cp_l[mask_cl]

    x_cp_u *= Config.CHORD
    x_cp_l *= Config.CHORD

    mask_cu = (x_cp_u >= x_min) & (x_cp_u <= x_max)
    mask_cl = (x_cp_l >= x_min) & (x_cp_l <= x_max)
    x_cp_u, cp_u = x_cp_u[mask_cu], cp_u[mask_cu]
    x_cp_l, cp_l = x_cp_l[mask_cl], cp_l[mask_cl]

    fcpu = Akima1DInterpolator(x_cp_u, cp_u)
    fcpl = Akima1DInterpolator(x_cp_l, cp_l)

    return fu, fl, fcpu, fcpl

# Total shape error solver
# area between deformed inner strips and target flap shapes
def compute_shape_error(nodes, u, info, fu, fl):
    N = info["N_nodes_chord"]

    # Deformed node positions
    def_nodes = nodes.copy()
    def_nodes[:, 0] += u[0::3]
    def_nodes[:, 1] += u[1::3]

    # Upper and lower inner strips
    xu = def_nodes[:N, 0]
    yu = def_nodes[:N, 1]
    xl = def_nodes[N:2 * N, 0]
    yl = def_nodes[N:2 * N, 1]

    # Sort by x
    su = np.argsort(xu)
    sl = np.argsort(xl)
    xu, yu = xu[su], yu[su]
    xl, yl = xl[sl], yl[sl]

    # Fixed x-grid in morphing region
    x_min = Config.MORPH_START * Config.CHORD
    x_max = Config.CHORD
    x_grid = np.linspace(x_min, x_max, 200)

    # Interpolate structural deflection onto x_grid
    yu_def = np.interp(x_grid, xu, yu)
    yl_def = np.interp(x_grid, xl, yl)

    # Target surfaces
    yu_tar = fu(x_grid)
    yl_tar = fl(x_grid)

    # Stack and remove any NaN/Inf
    arr = np.stack([yu_def, yl_def, yu_tar, yl_tar], axis=-1)
    mask = np.all(np.isfinite(arr), axis=-1)

    if mask.sum() < 10:
        return 1e6

    x_valid = x_grid[mask]
    yu_def_v = yu_def[mask]
    yl_def_v = yl_def[mask]
    yu_tar_v = yu_tar[mask]
    yl_tar_v = yl_tar[mask]

    err_u = trapezoid(np.abs(yu_def_v - yu_tar_v), x_valid)
    err_l = trapezoid(np.abs(yl_def_v - yl_tar_v), x_valid)

    J = float(err_u + err_l)
    if not np.isfinite(J):
        return 1e6
    return J


# NN MLP surrogate
# input takes in normalized thickness, 4 ribs
# outputs shape error and sigma
class SurrogateModel(nn.Module):
    def __init__(self, input_dim=5):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(input_dim, 32),
            nn.Tanh(),
            nn.Linear(32, 32),
            nn.Tanh(),
            nn.Linear(32, 2),
        )

    def forward(self, x):
        return self.net(x)


# LHS
def lhs(n_samples, dim, seed=0):
    rng = np.random.RandomState(seed)
    cut = np.linspace(0, 1, n_samples + 1)

    u = rng.rand(n_samples, dim)
    a = cut[:n_samples]
    b = cut[1:n_samples + 1]
    rdpoints = u * (b - a)[:, None] + a[:, None]

    H = np.zeros_like(rdpoints)
    for j in range(dim):
        order = rng.permutation(n_samples)
        H[:, j] = rdpoints[order, 0]

    return H


# Plotting
def plot_mode(nodes, elems, u, info, fu, fl, mode_name, color_struct="b", scale=1.0):
    N = info["N_nodes_chord"]

    def_nodes = nodes.copy()
    def_nodes[:, 0] += u[0::3] * scale
    def_nodes[:, 1] += u[1::3] * scale

    plt.figure(figsize=(10, 4))

    # Undeformed structure
    for (n1, n2) in elems:
        n1, n2 = int(n1), int(n2)
        plt.plot([nodes[n1, 0], nodes[n2, 0]],
                 [nodes[n1, 1], nodes[n2, 1]],
                 "k--", alpha=0.25)

    # Deformed structure
    for (n1, n2) in elems:
        n1, n2 = int(n1), int(n2)
        plt.plot([def_nodes[n1, 0], def_nodes[n2, 0]],
                 [def_nodes[n1, 1], def_nodes[n2, 1]],
                 color_struct + "-", lw=1.5)

    # Target flap upper/lower
    x_plot = np.linspace(Config.MORPH_START * Config.CHORD, Config.CHORD, 200)
    plt.plot(x_plot, fu(x_plot), "g--", lw=1.5, label=f"{mode_name} target upper")
    plt.plot(x_plot, fl(x_plot), "m--", lw=1.5, label=f"{mode_name} target lower")

    plt.axis("equal")
    plt.grid(True, alpha=0.3)
    plt.xlabel("Chordwise position x [m]")
    plt.ylabel("Thickness direction y [m]")
    plt.title(f"Morphing Trailing Edge – {mode_name}\n"
              f"(black = undeformed, {color_struct} = deformed x{scale:.1f})")
    plt.legend(loc="best")
    plt.tight_layout()
    plt.show()


def plot_overlay_modes(nodes, elems, u1, u2, info,
                       fu1, fl1, fu2, fl2, scale=5.0):
    N = info["N_nodes_chord"]

    def1 = nodes.copy()
    def1[:, 0] += u1[0::3] * scale
    def1[:, 1] += u1[1::3] * scale

    def2 = nodes.copy()
    def2[:, 0] += u2[0::3] * scale
    def2[:, 1] += u2[1::3] * scale

    plt.figure(figsize=(10, 4))

    # Undeformed
    for (n1, n2) in elems:
        n1, n2 = int(n1), int(n2)
        plt.plot([nodes[n1, 0], nodes[n2, 0]],
                 [nodes[n1, 1], nodes[n2, 1]],
                 "k--", alpha=0.15)

    # Climb
    for (n1, n2) in elems:
        n1, n2 = int(n1), int(n2)
        plt.plot([def1[n1, 0], def1[n2, 0]],
                 [def1[n1, 1], def1[n2, 1]],
                 "b-", lw=1.2, alpha=0.9)

    # Cruise
    for (n1, n2) in elems:
        n1, n2 = int(n1), int(n2)
        plt.plot([def2[n1, 0], def2[n2, 0]],
                 [def2[n1, 1], def2[n2, 1]],
                 "r-", lw=1.2, alpha=0.9)

    x_plot = np.linspace(Config.MORPH_START * Config.CHORD, Config.CHORD, 200)
    plt.plot(x_plot, fu1(x_plot), "c--", lw=1.2, label="Mode 1 target upper (-1°)")
    plt.plot(x_plot, fl1(x_plot), "c:",  lw=1.2, label="Mode 1 target lower (-1°)")
    plt.plot(x_plot, fu2(x_plot), "y--", lw=1.2, label="Mode 2 target upper (-5°)")
    plt.plot(x_plot, fl2(x_plot), "y:",  lw=1.2, label="Mode 2 target lower (-5°)")

    plt.axis("equal")
    plt.grid(True, alpha=0.3)
    plt.xlabel("Chordwise position x [m]")
    plt.ylabel("Thickness direction y [m]")
    plt.title(f"Morphing Trailing Edge – Overlay of Mode 1 and Mode 2\n"
              f"(deformation scaled by {scale:.1f}×)")
    plt.legend(loc="best", fontsize=8)
    plt.tight_layout()
    plt.show()


def plot_loss_curve(loss_history):
    plt.figure(figsize=(6, 4))
    plt.plot(loss_history, "-")
    plt.xlabel("Epoch")
    plt.ylabel("Training MSE loss")
    plt.title("Surrogate NN training loss")
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.show()

def plot_parity(y_true, y_pred, title, xlabel, ylabel):
    plt.figure(figsize=(5, 5))
    y_true = np.asarray(y_true)
    y_pred = np.asarray(y_pred)

    plt.scatter(y_true, y_pred, s=10, alpha=0.5)
    lims = [
        min(np.min(y_true), np.min(y_pred)),
        max(np.max(y_true), np.max(y_pred)),
    ]
    plt.plot(lims, lims, "k--", lw=1.0)
    plt.xlim(lims)
    plt.ylim(lims)
    plt.xlabel(xlabel)
    plt.ylabel(ylabel)
    plt.title(title)
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.show()


# Calibrate actuator strokes with aero loads accounted for
def find_best_actuator_disp_with_aero(geo, fem, fu, fl, fcpu, fcpl, q_inf,
                                      t_skin,
                                      rib1_param, rib2_param, rib3_param, rib4_param,
                                      u_min, u_max, n_u=60):

    # Build mesh for this baseline design
    nodes, elems, t_elems, info = geo.generate_mesh(
        t_skin,
        rib1_param, rib2_param, rib3_param, rib4_param
    )

    # Build aero loads for this mode
    F_aero = fem.build_aero_load_vector(nodes, info, fcpu, fcpl, q_inf)

    u_candidates = np.linspace(u_min, u_max, n_u)
    best_J = np.inf
    best_u = None

    for u_act in u_candidates:
        u, _ = fem.solve(
            nodes, elems, t_elems,
            actuator_disp=u_act,
            info=info,
            F_ext=F_aero
        )
        if u is None:
            continue

        J = compute_shape_error(nodes, u, info, fu, fl)
        if np.isfinite(J) and (J < best_J):
            best_J = J
            best_u = u_act

    return best_u, best_J


# Dataset generation from LHS
def generate_dataset(geo, fem, fu1, fl1, fu2, fl2, fcpu1, fcpl1, fcpu2, fcpl2,
                     use_aero=True, n_samples=100):
    input_dim = 5
    samples = lhs(n_samples, input_dim, seed=0)
    t_min, t_max = Config.get_thickness_bounds()

    X_list = []
    Y_list = []

    if use_aero:
        q1 = Config.q_mode1()
        q2 = Config.q_mode2()

    print(f"\n=== 3. Generating FEM dataset (LHS, UNIFORM thickness, "
          f"{'with aero' if use_aero else 'actuator only'}) ===")

    for i in range(n_samples):
        t_norm, rib1_param, rib2_param, rib3_param, rib4_param = samples[i]

        # Map normalized thickness to physical [t_min, t_max]
        t_skin = t_min + (t_max - t_min) * t_norm

        # Build mesh for this design
        nodes, elems, t_elems, info = geo.generate_mesh(
            t_skin,
            rib1_param, rib2_param, rib3_param, rib4_param
        )

        # Build aero loads if needed
        F_aero1 = None
        F_aero2 = None
        if use_aero:
            F_aero1 = fem.build_aero_load_vector(nodes, info, fcpu1, fcpl1, q1)
            F_aero2 = fem.build_aero_load_vector(nodes, info, fcpu2, fcpl2, q2)

        try:
            # Climb
            u1, sigma1 = fem.solve(
                nodes, elems, t_elems,
                actuator_disp=Config.ACTUATOR_MODE1,
                info=info,
                F_ext=F_aero1
            )
            if u1 is None:
                continue
            J1 = compute_shape_error(nodes, u1, info, fu1, fl1)

            # Cruise
            u2, sigma2 = fem.solve(
                nodes, elems, t_elems,
                actuator_disp=Config.ACTUATOR_MODE2,
                info=info,
                F_ext=F_aero2
            )
            if u2 is None:
                continue
            J2 = compute_shape_error(nodes, u2, info, fu2, fl2)

        except Exception as e:
            print(f"  Sample {i+1:3d} skipped due to error: {e}")
            continue

        if not (np.isfinite(J1) and np.isfinite(J2)):
            continue

        Jtot = J1 + J2
        sigma_max = max(sigma1, sigma2)

        X_list.append([t_norm, rib1_param, rib2_param, rib3_param, rib4_param])
        Y_list.append([Jtot, sigma_max])

        if (i + 1) % 25 == 0:
            print(
                f" Sample {i+1:3d} | "
                f"J1={J1:.4e}, J2={J2:.4e}, "
                f"sigma_max={sigma_max/1e6:6.2f} MPa"
            )

    X_raw = np.array(X_list, dtype=np.float32)
    Y_raw = np.array(Y_list, dtype=np.float32)

    print(f"\nCollected {X_raw.shape[0]} valid samples out of {n_samples} attempts.")
    return X_raw, Y_raw

# Ground truth FEM evaluation
# takes in normalized thickness and rib parameters for 4 ribs
# outputs individual and total shape error and max stress
def evaluate_design_FEM(t_norm,
                        rib1_param, rib2_param, rib3_param, rib4_param,
                        geo, fem,
                        fu1, fl1, fu2, fl2,
                        fcpu1, fcpl1, fcpu2, fcpl2,
                        use_aero=True):

    # Map normalized thickness to physical
    t_min, t_max = Config.get_thickness_bounds()
    t_skin = t_min + (t_max - t_min) * t_norm

    # Build mesh
    nodes, elems, t_elems, info = geo.generate_mesh(
        t_skin,
        rib1_param, rib2_param, rib3_param, rib4_param
    )

    # Optional aero loads
    if use_aero:
        q1 = Config.q_mode1()
        q2 = Config.q_mode2()
        F_aero1 = fem.build_aero_load_vector(nodes, info, fcpu1, fcpl1, q1)
        F_aero2 = fem.build_aero_load_vector(nodes, info, fcpu2, fcpl2, q2)
    else:
        F_aero1 = None
        F_aero2 = None

    # Climb
    u1, sigma1 = fem.solve(
        nodes, elems, t_elems,
        actuator_disp=Config.ACTUATOR_MODE1,
        info=info,
        F_ext=F_aero1
    )
    if u1 is None:
        return np.nan, np.nan, np.nan, np.nan

    J1 = compute_shape_error(nodes, u1, info, fu1, fl1)

    # Cruise
    u2, sigma2 = fem.solve(
        nodes, elems, t_elems,
        actuator_disp=Config.ACTUATOR_MODE2,
        info=info,
        F_ext=F_aero2
    )
    if u2 is None:
        return np.nan, np.nan, np.nan, np.nan

    J2 = compute_shape_error(nodes, u2, info, fu2, fl2)

    Jtot = J1 + J2
    sigma_max = max(sigma1, sigma2)

    return float(Jtot), float(J1), float(J2), float(sigma_max)


# Optimization workflow
def run_optimization():
    np.random.seed(0)
    torch.manual_seed(0)

    # Initialize scaled actuator defaults before anything else
    Config.init_scaled_defaults()

    print("=== 1. Geometry & FEM Setup ===")
    geo = WingGeometry()
    fem = FEMSolver()

    print("\n=== 2. Loading flap target shapes + Cp from XFOIL ===")
    fu1, fl1, fcpu1, fcpl1 = load_flap_shape_and_cp(
        Config.FLAP_PATH_MODE1, Config.FLAP_SHEET_MODE1
    )
    fu2, fl2, fcpu2, fcpl2 = load_flap_shape_and_cp(
        Config.FLAP_PATH_MODE2, Config.FLAP_SHEET_MODE2
    )
    print("  Loaded Mode 1 (-1°) and Mode 2 (-5°) flap shapes + Cp.")

    # Actuator stroke calibration
    print("\n=== 2a. Calibrating actuator strokes from XFOIL flap shapes (with aero) ===")
    t_min, t_max = Config.get_thickness_bounds()
    t_skin_cal = 0.5 * (t_min + t_max)   # mid thickness

    # mid in [0,1] for all ribs
    rib1_cal = 0.5
    rib2_cal = 0.5
    rib3_cal = 0.5
    rib4_cal = 0.5

    q1 = Config.q_mode1()
    q2 = Config.q_mode2()

    # Scaled search ranges
    u1_min, u1_max, u2_min, u2_max = Config.get_actuator_search_ranges()

    # Climb
    u1_star, J1_star = find_best_actuator_disp_with_aero(
        geo, fem, fu1, fl1, fcpu1, fcpl1, q1,
        t_skin_cal,
        rib1_cal, rib2_cal, rib3_cal, rib4_cal,
        u_min=u1_min, u_max=u1_max, n_u=60
    )

    # Cruise
    u2_star, J2_star = find_best_actuator_disp_with_aero(
        geo, fem, fu2, fl2, fcpu2, fcpl2, q2,
        t_skin_cal,
        rib1_cal, rib2_cal, rib3_cal, rib4_cal,
        u_min=u2_min, u_max=u2_max, n_u=80
    )

    if (u1_star is None) or (u2_star is None):
        print("  WARNING: actuator calibration failed; using scaled default strokes.")
    else:
        Config.ACTUATOR_MODE1 = float(u1_star)
        Config.ACTUATOR_MODE2 = float(u2_star)
        print(f"  Calibrated actuator strokes (with aero):")
        print(f"    Mode 1 (−1°): u_act ≈ {Config.ACTUATOR_MODE1*1e3:.2f} mm "
              f"(J_shape ≈ {J1_star:.4e})")
        print(f"    Mode 2 (−5°): u_act ≈ {Config.ACTUATOR_MODE2*1e3:.2f} mm "
              f"(J_shape ≈ {J2_star:.4e})")

    # Dataset
    X_raw, Y_raw = generate_dataset(
        geo, fem, fu1, fl1, fu2, fl2, fcpu1, fcpl1, fcpu2, fcpl2,
        use_aero=True, n_samples=500
    )

    # If aero completely breaks dataset, fall back to actuator-only
    if X_raw.shape[0] == 0:
        print("\nNo valid samples with aero loads – falling back to actuator-only dataset.")
        X_raw, Y_raw = generate_dataset(
            geo, fem, fu1, fl1, fu2, fl2, fcpu1, fcpl1, fcpu2, fcpl2,
            use_aero=False, n_samples=100
        )
        use_aero_for_validation = False
    else:
        use_aero_for_validation = True

    t_min, t_max = Config.get_thickness_bounds()


    # Train MLP
    print("\n=== 4. Training surrogate NN ===")

    # 80/20 data split
    N = X_raw.shape[0]
    perm = np.random.permutation(N)
    n_train = int(0.8 * N)
    train_idx = perm[:n_train]
    test_idx = perm[n_train:]

    X_train_np = X_raw[train_idx]
    Y_train_np = Y_raw[train_idx]
    X_test_np = X_raw[test_idx]
    Y_test_np = Y_raw[test_idx]

    X_train = torch.tensor(X_train_np, dtype=torch.float32)
    Y_train = torch.tensor(Y_train_np, dtype=torch.float32)
    X_test = torch.tensor(X_test_np, dtype=torch.float32)
    Y_test = torch.tensor(Y_test_np, dtype=torch.float32)

    # normalize outputs using train stats
    y_mean = Y_train.mean(0)
    y_std = Y_train.std(0) + 1e-6
    Y_train_norm = (Y_train - y_mean) / y_std

    model = SurrogateModel(input_dim=5)
    opt = optim.Adam(model.parameters(), lr=5e-3)
    loss_fn = nn.MSELoss()

    n_epochs = 1000
    loss_history = []

    for epoch in range(n_epochs):
        opt.zero_grad()
        pred_train = model(X_train)
        loss = loss_fn(pred_train, Y_train_norm)
        loss.backward()
        opt.step()

        loss_history.append(loss.item())

        if epoch % 150 == 0 or epoch == n_epochs - 1:
            print(f"  Epoch {epoch:4d}, loss = {loss.item():.3e}")

    # Plot training loss curve
    plot_loss_curve(loss_history)

    # Train/test metrics for N.N. validation
    with torch.no_grad():
        pred_train_norm = model(X_train)
        pred_test_norm = model(X_test)

        pred_train = pred_train_norm * y_std + y_mean
        pred_test = pred_test_norm * y_std + y_mean

    Y_train_true = Y_train_np
    Y_test_true = Y_test_np
    Y_train_pred = pred_train.cpu().numpy()
    Y_test_pred = pred_test.cpu().numpy()

    def compute_metrics(y_true, y_pred, name):
        y_true = np.asarray(y_true)
        y_pred = np.asarray(y_pred)
        mse = np.mean((y_true - y_pred) ** 2, axis=0)
        rmse = np.sqrt(mse)
        r2 = 1.0 - np.sum((y_true - y_pred) ** 2, axis=0) / np.sum(
            (y_true - y_true.mean(axis=0)) ** 2, axis=0
        )
        print(f"\n{name} RMSE:")
        print(f"  J_shape   : {rmse[0]:.4e}")
        print(f"  sigma_max : {rmse[1]/1e6:.3f} MPa")
        print(f"{name} R^2:")
        print(f"  J_shape   : {r2[0]:.4f}")
        print(f"  sigma_max : {r2[1]:.4f}")

    compute_metrics(Y_train_true, Y_train_pred, "TRAIN")
    compute_metrics(Y_test_true, Y_test_pred, "TEST")

    # Parity plots
    plot_parity(
        Y_train_true[:, 0],
        Y_train_pred[:, 0],
        "Parity plot – J_shape (train)",
        "True J_shape",
        "Pred J_shape",
    )
    plot_parity(
        Y_test_true[:, 0],
        Y_test_pred[:, 0],
        "Parity plot – J_shape (test)",
        "True J_shape",
        "Pred J_shape",
    )

    plot_parity(
        Y_train_true[:, 1],
        Y_train_pred[:, 1],
        "Parity plot – sigma_max (train)",
        "True sigma_max [Pa]",
        "Pred sigma_max [Pa]",
    )
    plot_parity(
        Y_test_true[:, 1],
        Y_test_pred[:, 1],
        "Parity plot – sigma_max (test)",
        "True sigma_max [Pa]",
        "Pred sigma_max [Pa]",
    )

    # store tensors & stats for later optimization
    y_mean_t = y_mean.detach()
    y_std_t = y_std.detach()


    # Mult-start gradient based optimization with unfiform thickness across
    # upper and lower skins and ribs
    print("\n=== 5. Gradient-based design optimization (UNIFORM thickness) ===")

    # Hyperparameters for penalties
    wsigma = 0
    wt = 0 # thickness penalty to encourage thin designs, already normalized to 1
    wspace = 1e-3 # rib spacing penalty weight
    delta_space = 0.02 # spacing length scale in chord fraction

    def surrogate_objective(x_param):
        out_norm = model(x_param.unsqueeze(0))
        out_phys = out_norm * y_std_t + y_mean_t  # un-normalize

        Jshape_pred = out_phys[0, 0]
        sigma_pred = out_phys[0, 1]
        sigma_nd = sigma_pred / Config.YIELD_STRESS

        # stress penalty
        stress_violation = torch.relu(sigma_nd - 1.0)

        # thickness penalty
        t_norm = x_param[0]
        t_penalty = t_norm

        # spacing penalty
        rib_params = x_param[1:]  # r1..r4
        rib_fracs = 0.75 + 0.20 * rib_params
        J_space = 0.0
        for i in range(4):
            for j in range(i + 1, 4):
                J_space = J_space + torch.exp(
                    -torch.abs(rib_fracs[i] - rib_fracs[j]) / delta_space
                )

        J = Jshape_pred + wsigma * stress_violation + wt * t_penalty + wspace * J_space
        return J, Jshape_pred, sigma_pred

    n_steps = 1000
    n_restarts = 5

    best_global_x = None
    best_global_J = float("inf")

    for r in range(n_restarts):
        if r == 0:
            # first restart to mean training designs
            x0 = X_train.mean(0).clone().detach()
        else:
            # next 4 restarts random in design space domain
            x0 = torch.rand(5)

        x0.requires_grad_(True)
        opt_x = optim.Adam([x0], lr=0.02)

        for step in range(n_steps):
            opt_x.zero_grad()
            J, Jshape_pred, sigma_pred = surrogate_objective(x0)
            J.backward()
            opt_x.step()

            with torch.no_grad():
                x0.clamp_(0.0, 1.0)

            if (r == 0) and (step % 50 == 0 or step == n_steps - 1):
                print(
                    f"  [restart 0] Step {step:3d} | "
                    f"Jshape={Jshape_pred.item():.4e}, "
                    f"sigma={sigma_pred.item()/1e6:6.2f} MPa"
                )

        # evaluate final J for this restart
        with torch.no_grad():
            J_final, _, _ = surrogate_objective(x0)

        if J_final.item() < best_global_J:
            best_global_J = J_final.item()
            best_global_x = x0.detach().clone()

    print(f"\n  Best surrogate J after {n_restarts} restarts: {best_global_J:.4e}")

    # FEM refinemenent around best parameters determined by MLP
    def evaluate_true_objective(x_vec_np):
        x_vec_np = np.clip(np.asarray(x_vec_np, dtype=float), 0.0, 1.0)
        t_norm, r1, r2, r3, r4 = x_vec_np
        t_skin = t_min + (t_max - t_min) * t_norm

        nodes_loc, elems_loc, t_elems_loc, info_loc = geo.generate_mesh(
            t_skin, r1, r2, r3, r4
        )

        if use_aero_for_validation:
            q1 = Config.q_mode1()
            q2 = Config.q_mode2()
            F_aero1_loc = fem.build_aero_load_vector(
                nodes_loc, info_loc, fcpu1, fcpl1, q1
            )
            F_aero2_loc = fem.build_aero_load_vector(
                nodes_loc, info_loc, fcpu2, fcpl2, q2
            )
        else:
            F_aero1_loc = None
            F_aero2_loc = None

        # Climb
        u1_loc, sigma1_loc = fem.solve(
            nodes_loc, elems_loc, t_elems_loc,
            Config.ACTUATOR_MODE1, info_loc, F_ext=F_aero1_loc
        )
        J1_loc = compute_shape_error(nodes_loc, u1_loc, info_loc, fu1, fl1)

        # Cruise
        u2_loc, sigma2_loc = fem.solve(
            nodes_loc, elems_loc, t_elems_loc,
            Config.ACTUATOR_MODE2, info_loc, F_ext=F_aero2_loc
        )
        J2_loc = compute_shape_error(nodes_loc, u2_loc, info_loc, fu2, fl2)

        Jshape_loc = J1_loc + J2_loc
        sigma_max_loc = max(sigma1_loc, sigma2_loc)

        sigma_nd_loc = sigma_max_loc / Config.YIELD_STRESS
        stress_violation_loc = max(0.0, sigma_nd_loc - 1.0)
        t_penalty_loc = t_norm

        # spacing penalty
        rib_fracs_np = 0.75 + 0.20 * np.array([r1, r2, r3, r4])
        J_space_np = 0.0
        for i in range(4):
            for j in range(i + 1, 4):
                J_space_np += np.exp(-abs(rib_fracs_np[i] - rib_fracs_np[j]) / delta_space)

        J_total_loc = (
            Jshape_loc
            + wsigma * stress_violation_loc
            + wt * t_penalty_loc
            + wspace * J_space_np
        )
        return J_total_loc, Jshape_loc, sigma_max_loc

    best_x_np = best_global_x.cpu().numpy()
    best_J_true, best_Jshape_true, best_sigma_true = evaluate_true_objective(best_x_np)

    print(
        f"  FEM refinement start: J_true={best_J_true:.4e}, "
        f"Jshape={best_Jshape_true:.4e}, "
        f"sigma_max={best_sigma_true/1e6:6.2f} MPa"
    )

    delta_local = 0.03 # step in design space
    for it in range(2): # few sweeps
        improved = False
        for j in range(5):
            for step in (-delta_local, delta_local):
                cand = best_x_np.copy()
                cand[j] = np.clip(cand[j] + step, 0.0, 1.0)
                J_cand, Jshape_cand, sigma_cand = evaluate_true_objective(cand)
                if J_cand < best_J_true:
                    best_J_true = J_cand
                    best_Jshape_true = Jshape_cand
                    best_sigma_true = sigma_cand
                    best_x_np = cand
                    improved = True
        if not improved:
            break

    print(
        f"  FEM refinement end  : J_true={best_J_true:.4e}, "
        f"Jshape={best_Jshape_true:.4e}, "
        f"sigma_max={best_sigma_true/1e6:6.2f} MPa"
    )

    best_x = torch.tensor(best_x_np, dtype=torch.float32)


    # Decode optimal design and validate with FEM
    best = best_x.detach().cpu().numpy()
    t_norm_opt, rib1_opt, rib2_opt, rib3_opt, rib4_opt = best
    t_skin_opt = t_min + (t_max - t_min) * t_norm_opt
    rib1_frac = 0.75 + 0.20 * rib1_opt
    rib2_frac = 0.75 + 0.20 * rib2_opt
    rib3_frac = 0.75 + 0.20 * rib3_opt
    rib4_frac = 0.75 + 0.20 * rib4_opt

    print(f"\nUniform flex-strip thickness (skin) ≈ {t_skin_opt*1e3:.3f} mm")
    print("Rib locations (as % chord):")
    print(f"  Rib 1 @ {rib1_frac*100:.1f}% c")
    print(f"  Rib 2 @ {rib2_frac*100:.1f}% c")
    print(f"  Rib 3 @ {rib3_frac*100:.1f}% c")
    print(f"  Rib 4 @ {rib4_frac*100:.1f}% c")

    # Thickness sweep at optimal rib locations for validation
    print("\n=== 6. Thickness sweep at fixed optimal rib locations (true FEM) ===")

    # Sweep normalized thickness between 0 and 1
    t_norm_vals = np.linspace(0.0, 1.0, 100)  # 100 points across the range
    Jtot_vals = []
    sigma_vals = []

    for t_norm_sweep in t_norm_vals:
        Jtot, J1_s, J2_s, sigma_max_s = evaluate_design_FEM(
            t_norm_sweep,
            rib1_opt, rib2_opt, rib3_opt, rib4_opt,
            geo, fem,
            fu1, fl1, fu2, fl2,
            fcpu1, fcpl1, fcpu2, fcpl2,
            use_aero=use_aero_for_validation
        )
        Jtot_vals.append(Jtot)
        sigma_vals.append(sigma_max_s)

    Jtot_vals = np.array(Jtot_vals)
    sigma_vals = np.array(sigma_vals)

    # Convert thickness to physical mm for plotting
    t_min, t_max = Config.get_thickness_bounds()
    t_skin_vals = t_min + (t_max - t_min) * t_norm_vals
    t_skin_mm = t_skin_vals * 1e3

    # Report the best FEM thickness from the sweep
    valid_mask = np.isfinite(Jtot_vals)
    if np.any(valid_mask):
        idx_best = np.argmin(Jtot_vals[valid_mask])
        # Need to map back into full array indices
        full_indices = np.where(valid_mask)[0]
        idx_best = full_indices[idx_best]

        print(f"  Min J_shape (true FEM sweep) at t ≈ {t_skin_mm[idx_best]:.3f} mm "
              f"(t_norm ≈ {t_norm_vals[idx_best]:.3f}), "
              f"sigma_max ≈ {sigma_vals[idx_best]/1e6:6.2f} MPa")
    else:
        print("  WARNING: all thickness sweep evaluations returned NaN J_shape.")

    # Plotting
    plt.figure(figsize=(6, 4))
    plt.plot(t_skin_mm, Jtot_vals, "-o")
    plt.xlabel("Uniform skin thickness t [mm]")
    plt.ylabel("Combined shape error J_shape (m²)")
    plt.title("True FEM: J_shape vs skin thickness (fixed ribs)")
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.show()


    plt.figure(figsize=(6, 4))
    plt.plot(t_skin_mm, sigma_vals / 1e6, "-o")
    plt.axhline(Config.YIELD_STRESS / 1e6, linestyle="--", label="Yield stress")
    plt.xlabel("Uniform skin thickness t [mm]")
    plt.ylabel("Max von Mises stress [MPa]")
    plt.title("True FEM: σ_max vs skin thickness (fixed ribs)")
    plt.legend()
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.show()


    print("\n=== 6. Full FEM validation of optimized design "
          f"(both modes, {'with aero' if use_aero_for_validation else 'actuator only'}) ===")
    geo_val = geo
    fem_val = fem
    nodes, elems, t_elems, info = geo_val.generate_mesh(
        t_skin_opt,
        rib1_opt, rib2_opt, rib3_opt, rib4_opt
    )

    if use_aero_for_validation:
        q1 = Config.q_mode1()
        q2 = Config.q_mode2()
        F_aero1 = fem_val.build_aero_load_vector(nodes, info, fcpu1, fcpl1, q1)
        F_aero2 = fem_val.build_aero_load_vector(nodes, info, fcpu2, fcpl2, q2)
    else:
        F_aero1 = None
        F_aero2 = None

    # Climb
    u1, sigma1 = fem_val.solve(
        nodes, elems, t_elems, Config.ACTUATOR_MODE1, info, F_ext=F_aero1
    )
    J1 = compute_shape_error(nodes, u1, info, fu1, fl1)

    # Cruise
    u2, sigma2 = fem_val.solve(
        nodes, elems, t_elems, Config.ACTUATOR_MODE2, info, F_ext=F_aero2
    )
    J2 = compute_shape_error(nodes, u2, info, fu2, fl2)

    print(f"  Mode 1 (-1°):  J_shape = {J1:.4e}, sigma_max = {sigma1/1e6:6.2f} MPa")
    print(f"  Mode 2 (-5°):  J_shape = {J2:.4e}, sigma_max = {sigma2/1e6:6.2f} MPa")
    print(f"  Combined J    = {J1+J2:.4e}")
    print(f"  Max sigma     = {max(sigma1, sigma2)/1e6:6.2f} MPa "
          f"(yield {Config.YIELD_STRESS/1e6:.1f} MPa)")

    plot_mode(nodes, elems, u1, info, fu1, fl1,
              mode_name="Mode 1 (−1° flap)", color_struct="b", scale=1.0)
    plot_mode(nodes, elems, u2, info, fu2, fl2,
              mode_name="Mode 2 (−5° flap)", color_struct="r", scale=1.0)
    plot_overlay_modes(nodes, elems, u1, u2, info, fu1, fl1, fu2, fl2, scale=1.0)


if __name__ == "__main__":
    run_optimization()
